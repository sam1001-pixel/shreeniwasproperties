# ==============================================================================
# SHREENIWAS RENTALS & PROPERTIES - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local and fill with your secret values.
# NEVER commit .env.local to Git or include in public archives.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin & Authentication Security (CRITICAL)
ADMIN_EMAIL=superadmin@shreeniwasproperties.com
ADMIN_PASSWORD=your_strong_admin_password_here
# Optional bcrypt hash alternative:
# ADMIN_PASSWORD_HASH=$2b$10$...
STAFF_ADMIN_EMAIL=admin@shreeniwasproperties.com
STAFF_ADMIN_PASSWORD=your_staff_admin_password_here
ADMIN_JWT_SECRET=your_minimum_32_char_cryptographically_secure_random_jwt_secret

# Email Dispatch Configuration (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.shreeniwasproperties.in
